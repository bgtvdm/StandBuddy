// Generated from ui/themes.css + ui/panel.css (v2.1): six palettes, each with a light and a
// dark panel variant, plus the overlay palette. Rust sets `palette` (0 warm, 1 ocean, 2 forest,
// 3 lavender, 4 slate, 5 rose) and `dark`. Shadows and blur are not carried over (software renderer).
export global Theme {
    in-out property <int> palette: 0;
    in-out property <bool> dark: true;
    // Added to every DM Sans weight. Slint's software renderer blends glyph coverage without
    // gamma: light-on-dark text comes out thinner than v2's DirectWrite text, dark-on-light
    // about the same. Tuned by the ink of one label vs v2.1.2 (2026-11-19): dark 65.6k → 78.9k
    // (v2 84.5k, the rest is ClearType fringes); light needs none. Overlays keep dark = true.
    out property <int> text-boost: root.dark ? 120 : 0;
    property <[color]> bg-base-light: [#faf8f5, #f5f8fa, #f5f8f5, #f8f5fa, #f5f6f7, #faf5f6];
    property <[color]> bg-base-dark: [#1a1612, #0d1520, #0d150d, #150d18, #12151a, #180d10];
    out property <color> bg-base: root.dark ? root.bg-base-dark[root.palette] : root.bg-base-light[root.palette];
    property <[color]> bg-card-light: [#ffffff, #ffffff, #ffffff, #ffffff, #ffffff, #ffffff];
    property <[color]> bg-card-dark: [#27231f, #1a222d, #1a221a, #221a25, #1f2227, #251a1d];
    out property <color> bg-card: root.dark ? root.bg-card-dark[root.palette] : root.bg-card-light[root.palette];
    property <[color]> bg-stat-light: [#faf8f5, #f5f8fa, #f5f8f5, #f8f5fa, #f5f6f7, #faf5f6];
    property <[color]> bg-stat-dark: [#27231f, #1a222d, #1a221a, #221a25, #1f2227, #251a1d];
    out property <color> bg-stat: root.dark ? root.bg-stat-dark[root.palette] : root.bg-stat-light[root.palette];
    property <[color]> bg-input-light: [#ffffff, #ffffff, #ffffff, #ffffff, #ffffff, #ffffff];
    property <[color]> bg-input-dark: [#2a2622, #1c242f, #1c241c, #241c28, #212429, #281c1f];
    out property <color> bg-input: root.dark ? root.bg-input-dark[root.palette] : root.bg-input-light[root.palette];
    property <[color]> border-subtle-light: [#00000014, #00000014, #00000014, #00000014, #00000014, #00000014];
    property <[color]> border-subtle-dark: [#faf6f021, #e8f2fa21, #e8f2e821, #f2e8f821, #e8eaee21, #f8e8ec21];
    out property <color> border-subtle: root.dark ? root.border-subtle-dark[root.palette] : root.border-subtle-light[root.palette];
    property <[color]> border-focus-light: [#c9a86c, #5b9bd5, #6b9b6b, #9b7bb8, #6b7b8b, #c98b9b];
    property <[color]> border-focus-dark: [#e8b866, #6bb3e8, #8bc98b, #c9a0e8, #a0b0c0, #e8a8b8];
    out property <color> border-focus: root.dark ? root.border-focus-dark[root.palette] : root.border-focus-light[root.palette];
    property <[color]> accent-light: [#c9a86c, #5b9bd5, #6b9b6b, #9b7bb8, #6b7b8b, #c98b9b];
    property <[color]> accent-dark: [#e8b866, #6bb3e8, #8bc98b, #c9a0e8, #a0b0c0, #e8a8b8];
    out property <color> accent: root.dark ? root.accent-dark[root.palette] : root.accent-light[root.palette];
    property <[color]> accent-hover-light: [#b8955b, #4a8ac4, #5a8a5a, #8a6aa7, #5a6a7a, #b87a8a];
    property <[color]> accent-hover-dark: [#ebc27b, #80beeb, #9bd19b, #d1adeb, #adbbc9, #ebb4c2];
    out property <color> accent-hover: root.dark ? root.accent-hover-dark[root.palette] : root.accent-hover-light[root.palette];
    property <[color]> accent-soft-light: [#c9a86c1f, #5b9bd51f, #6b9b6b1f, #9b7bb81f, #6b7b8b1f, #c98b9b1f];
    property <[color]> accent-soft-dark: [#e8b86626, #6bb3e826, #8bc98b26, #c9a0e826, #a0b0c026, #e8a8b826];
    out property <color> accent-soft: root.dark ? root.accent-soft-dark[root.palette] : root.accent-soft-light[root.palette];
    property <[color]> accent-glow-light: [#c9a86c40, #5b9bd540, #6b9b6b40, #9b7bb840, #6b7b8b40, #c98b9b40];
    property <[color]> accent-glow-dark: [#e8b86699, #6bb3e899, #8bc98b99, #c9a0e899, #a0b0c099, #e8a8b899];
    out property <color> accent-glow: root.dark ? root.accent-glow-dark[root.palette] : root.accent-glow-light[root.palette];
    property <[color]> text-primary-light: [#1a1612, #1a2632, #1a261a, #201a26, #1a1e22, #261a1e];
    property <[color]> text-primary-dark: [#faf6f0, #e8f2fa, #e8f2e8, #f2e8f8, #e8eaee, #f8e8ec];
    out property <color> text-primary: root.dark ? root.text-primary-dark[root.palette] : root.text-primary-light[root.palette];
    property <[color]> text-secondary-light: [#5c5550, #4a5c6a, #4a5c4a, #5c4a6a, #4a5560, #6a4a55];
    property <[color]> text-secondary-dark: [#faf6f0b2, #e8f2fab2, #e8f2e8b2, #f2e8f8b2, #e8eaeeb2, #f8e8ecb2];
    out property <color> text-secondary: root.dark ? root.text-secondary-dark[root.palette] : root.text-secondary-light[root.palette];
    property <[color]> text-muted-light: [#9c958e, #8a9aa8, #8a9a8a, #9a8aa8, #8a9198, #a88a92];
    property <[color]> text-muted-dark: [#faf6f073, #e8f2fa73, #e8f2e873, #f2e8f873, #e8eaee73, #f8e8ec73];
    out property <color> text-muted: root.dark ? root.text-muted-dark[root.palette] : root.text-muted-light[root.palette];
    property <[color]> text-on-accent-light: [#1a1612, #1a2632, #1a261a, #201a26, #ffffff, #261a1e];
    property <[color]> text-on-accent-dark: [#1a1612, #0d1520, #0d150d, #150d18, #12151a, #180d10];
    out property <color> text-on-accent: root.dark ? root.text-on-accent-dark[root.palette] : root.text-on-accent-light[root.palette];
    property <[color]> danger-light: [#c75f4a, #c75f5f, #c7755f, #c75f7a, #c75f5f, #c75f5f];
    property <[color]> danger-dark: [#e88266, #e87a7a, #e8a07a, #e87a9a, #e88080, #e87a7a];
    out property <color> danger: root.dark ? root.danger-dark[root.palette] : root.danger-light[root.palette];
    property <[color]> danger-soft-light: [#c75f4a14, #c75f5f14, #c7755f14, #c75f7a14, #c75f5f14, #c75f5f14];
    property <[color]> danger-soft-dark: [#e8826624, #e87a7a24, #e8a07a24, #e87a9a24, #e8808024, #e87a7a24];
    out property <color> danger-soft: root.dark ? root.danger-soft-dark[root.palette] : root.danger-soft-light[root.palette];
    property <[color]> accent-ink-light: [#725f3f, #3a6084, #426042, #5e4a6f, #424c56, #78525c];
    property <[color]> accent-ink-dark: [#e8b866, #6bb3e8, #8bc98b, #c9a0e8, #a0b0c0, #e8a8b8];
    out property <color> accent-ink: root.dark ? root.accent-ink-dark[root.palette] : root.accent-ink-light[root.palette];
    property <[color]> overlay-bg-1-all: [#1a1612, #0d1520, #0d150d, #150d18, #12151a, #180d10];
    out property <color> overlay-bg-1: root.overlay-bg-1-all[root.palette];
    property <[color]> overlay-bg-2-all: [#2d2319, #152535, #152515, #251528, #1e2228, #281518];
    out property <color> overlay-bg-2: root.overlay-bg-2-all[root.palette];
    property <[color]> overlay-accent-all: [#e8b866, #6bb3e8, #8bc98b, #c9a0e8, #a0b0c0, #e8a8b8];
    out property <color> overlay-accent: root.overlay-accent-all[root.palette];
    property <[color]> overlay-accent-dim-all: [#e8b86699, #6bb3e899, #8bc98b99, #c9a0e899, #a0b0c099, #e8a8b899];
    out property <color> overlay-accent-dim: root.overlay-accent-dim-all[root.palette];
    property <[color]> overlay-accent-glow-all: [#e8b86626, #6bb3e826, #8bc98b26, #c9a0e826, #a0b0c026, #e8a8b826];
    out property <color> overlay-accent-glow: root.overlay-accent-glow-all[root.palette];
    property <[color]> overlay-text-all: [#faf6f0, #e8f2fa, #e8f2e8, #f2e8f8, #e8eaee, #f8e8ec];
    out property <color> overlay-text: root.overlay-text-all[root.palette];
    property <[color]> overlay-text-secondary-all: [#faf6f0b2, #e8f2fab2, #e8f2e8b2, #f2e8f8b2, #e8eaeeb2, #f8e8ecb2];
    out property <color> overlay-text-secondary: root.overlay-text-secondary-all[root.palette];
    property <[color]> overlay-text-muted-all: [#faf6f073, #e8f2fa73, #e8f2e873, #f2e8f873, #e8eaee73, #f8e8ec73];
    out property <color> overlay-text-muted: root.overlay-text-muted-all[root.palette];
    property <[color]> overlay-danger-all: [#e88266, #e87a7a, #e8a07a, #e87a9a, #e88080, #e87a7a];
    out property <color> overlay-danger: root.overlay-danger-all[root.palette];
    property <[color]> overlay-danger-soft-all: [#e8826680, #e87a7a80, #e8a07a80, #e87a9a80, #e8808080, #e87a7a80];
    out property <color> overlay-danger-soft: root.overlay-danger-soft-all[root.palette];
    property <[color]> overlay-danger-fill-all: [#e8826640, #e87a7a40, #e8a07a40, #e87a9a40, #e8808040, #e87a7a40];
    out property <color> overlay-danger-fill: root.overlay-danger-fill-all[root.palette];
}
