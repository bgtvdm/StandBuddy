// Game-time warning toast — v2 ui/game-warning.html. The window is exactly the toast's size,
// click-through and never activated (ui.rs); the toast slides in from the right edge of its
// own window and out again at 6.6 s, like v2. The software renderer has no window alpha, so
// the area the toast slides over is `key`, made transparent by a Win32 colour key (ui.rs).
// Not ported: the drop shadow and the slide-out fade.
import { Theme } from "theme.slint";
import "fonts/DMSans-Variable.ttf";

export component GameWarning inherits Window {
    in property <image> game-icon;
    in property <int> minutes-left: 30;
    in property <color> key;
    out property <length> outer-width: root.width;
    out property <length> outer-height: root.height;

    title: "StandBuddy game warning";
    no-frame: true;
    always-on-top: true;
    default-font-family: "DM Sans";
    background: root.key;
    width: min(340px, toast-layout.preferred-width);
    height: toast-layout.preferred-height;

    property <bool> entered;
    property <bool> leaving;
    Timer { interval: 30ms; running: !root.entered; triggered => { root.entered = true; } }
    Timer { interval: 6.6s; running: root.entered && !root.leaving; triggered => { root.leaving = true; } }

    toast := Rectangle {
        width: root.width;
        height: root.height;
        border-radius: 14px;
        border-width: 1px;
        border-color: Theme.overlay-accent;
        background: @linear-gradient(145deg, Theme.overlay-bg-1 0%, Theme.overlay-bg-2 100%);
        clip: true;
        toast-layout := HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 16px;
            padding-bottom: 16px;
            spacing: 14px;
            alignment: start;
            // 34 px emoji (44 px box, see ui.rs `icon`).
            Image { source: root.game-icon; width: 44px; height: 44px; y: (parent.height - self.height) / 2; }
            VerticalLayout {
                alignment: center;
                spacing: 3px;
                Text {
                    text: "\{root.minutes-left} \{root.minutes-left == 1 ? "minute" : "minutes"} of game time left";
                    font-size: 16px;
                    font-weight: 600;
                    letter-spacing: 0.2px;
                    color: Theme.overlay-accent;
                }
                Text {
                    text: "Daily game limit approaching";
                    font-size: 13px;
                    font-weight: 300;
                    color: Theme.overlay-text-muted;
                }
            }
        }
    }

    states [
        waiting when !root.entered: {
            toast.x: root.width * 1.2;
            out { animate toast.x { duration: 350ms; easing: cubic-bezier(0.22, 1, 0.36, 1); } }
        }
        gone when root.leaving: {
            toast.x: root.width * 1.2;
            in { animate toast.x { duration: 400ms; easing: ease-in; } }
        }
    ]
}
